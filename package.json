{
  "name": "bcs-mentor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "auth:schema": "node --experimental-strip-types scripts/generate-auth-schema.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "test:security": "prisma generate && node --experimental-strip-types --conditions=react-server --test tests/security/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "node --experimental-strip-types scripts/run-db-integration-tests.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.12",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "dotenv": "18.0.9",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "auth": "1.7.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.0.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.0.0"
  }
}
