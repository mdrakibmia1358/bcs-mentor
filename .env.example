# Phase A: public pages and offline generation require no credentials.
# Copy to an ignored .env only when configuring an approved nonproduction DB.
# Leave these blank until real values are available through secure local setup.
# Never put these variables behind a NEXT_PUBLIC_ prefix.

# Pooled PostgreSQL URL for runtime; Neon hostname must contain -pooler.
# Remote connections require sslmode=verify-full (certificate + hostname checks).
DATABASE_URL=

# Direct, unpooled URL used only by Prisma CLI migration commands.
DIRECT_URL=

# Generate at least 32 random bytes locally; never reuse an example secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Signup is disabled in code. There is intentionally no environment toggle.
# Resend credentials and a verified sender will be configured in Phase B.
# BETTER_AUTH_SECRETS and BETTER_AUTH_TRUSTED_ORIGINS are unsupported.
# Leave both unset; even empty definitions are rejected before auth initialization.
# BETTER_AUTH_TELEMETRY, BETTER_AUTH_TELEMETRY_ENDPOINT and
# BETTER_AUTH_TELEMETRY_DEBUG are unsupported, including empty definitions.
# The same guard applies to the offline auth:schema entry point.
